<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Norseed: ferramentas e gestão do produtor rural, com dado oficial e uma conta só.">
<meta name="theme-color" content="#04100a">
<title>Norseed · Apresentação</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌱%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap">
<style>
:root{--bg:#04100a;--bg2:#0a2614;--g:#3ddc84;--g2:#1f9d55;--lime:#b6f23c;--gold:#f2c14e;--ink:#eefaf0;--mut:rgba(238,250,240,.72);--card:rgba(8,32,18,.66);--line:rgba(61,220,132,.26);--glow:rgba(61,220,132,.38);--warn:#f2a65a;
--d:'Sora','Inter',system-ui,sans-serif;--f:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;--m:ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace}
*{box-sizing:border-box}html,body{height:100%}
body{margin:0;overflow:hidden;background:var(--bg);color:var(--ink);font:400 clamp(15px,1.5vw,19px)/1.55 var(--f)}
#fx{position:fixed;inset:0;z-index:0}
.sky{position:fixed;inset:0;z-index:0;background:radial-gradient(700px 380px at 50% 62%,rgba(242,193,78,.2),transparent 70%),radial-gradient(1100px 600px at 15% 0,var(--bg2),transparent 65%)}
.field{position:fixed;left:-30%;right:-30%;bottom:0;height:46vh;z-index:0;transform:perspective(520px) rotateX(64deg);transform-origin:50% 100%;pointer-events:none;
background:repeating-linear-gradient(90deg,transparent 0 46px,rgba(61,220,132,.38) 46px 48px),repeating-linear-gradient(0deg,rgba(182,242,60,.14) 0 22px,transparent 22px 44px);background-size:100% 100%,100% 44px;animation:rows 2.4s linear infinite;
-webkit-mask-image:linear-gradient(to top,#000 20%,transparent 92%);mask-image:linear-gradient(to top,#000 20%,transparent 92%)}
@keyframes rows{to{background-position:0 0,0 44px}}
.scan{position:fixed;left:0;right:0;top:0;height:2px;z-index:2;background:linear-gradient(90deg,transparent,var(--g),transparent);box-shadow:0 0 18px 2px var(--glow);opacity:.5;animation:sweep 7s linear infinite;pointer-events:none}
@keyframes sweep{to{transform:translateY(100vh)}}
.top{position:fixed;left:0;right:0;top:0;height:3px;z-index:31}.top i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--lime),var(--g));box-shadow:0 0 14px var(--glow);transition:width .5s}
.hud{position:fixed;top:14px;left:18px;right:18px;z-index:20;display:flex;justify-content:space-between;font:500 11px var(--m);letter-spacing:.14em;text-transform:uppercase;color:var(--mut);pointer-events:none}
.hud b{color:var(--g);font-weight:600}
.deck{position:fixed;inset:0;z-index:5}
.slide{position:absolute;inset:0;padding:clamp(48px,8vh,84px) clamp(20px,6vw,88px) 96px;overflow-y:auto;display:flex;flex-direction:column;justify-content:center;opacity:0;visibility:hidden;transform:translateY(24px) scale(.985);filter:blur(6px);transition:opacity .6s,transform .6s,filter .6s,visibility .6s}
.slide.on{opacity:1;visibility:visible;transform:none;filter:none}
.in{max-width:1100px;width:100%;margin:0 auto}
.tag{font:600 12px var(--m);letter-spacing:.2em;text-transform:uppercase;color:var(--lime);display:inline-flex;gap:10px;align-items:center;margin-bottom:14px}
.tag::before{content:"";width:22px;height:2px;background:var(--lime);box-shadow:0 0 10px var(--lime)}
h1,h2{font-family:var(--d);margin:0;letter-spacing:-.03em;line-height:1.04;text-wrap:balance}
h1{font-size:clamp(54px,12vw,140px);font-weight:800;background:linear-gradient(95deg,#fff 10%,var(--g) 55%,var(--lime));-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 24px var(--glow))}
h2{font-size:clamp(28px,4.4vw,52px);font-weight:700;margin-bottom:12px}h2 em{font-style:normal;color:var(--g);text-shadow:0 0 22px var(--glow)}
.lead{color:var(--mut);max-width:62ch;margin:0 0 20px;font-size:1.05em}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;box-shadow:0 0 0 1px rgba(255,255,255,.02) inset,0 14px 50px -24px var(--glow)}
.card::before,.card::after{content:"";position:absolute;width:14px;height:14px;border:2px solid var(--g);opacity:.8}
.card::before{top:-1px;left:-1px;border-right:0;border-bottom:0;border-top-left-radius:16px}.card::after{right:-1px;bottom:-1px;border-left:0;border-top:0;border-bottom-right-radius:16px}
.card h3{margin:0 0 6px;font:700 1.08em var(--d);color:var(--g)}.card p{margin:0;color:var(--mut);font-size:.94em}
.grid{display:grid;gap:16px}.g2{grid-template-columns:1fr 1fr}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.chip{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:7px 14px;font-size:.86em;font-weight:500}
.chip.s{font:600 .68em var(--m);letter-spacing:.06em;text-transform:uppercase;padding:3px 9px;border-color:var(--g2);color:var(--g)}
.chip.w{color:var(--warn);border-color:rgba(242,166,90,.4);background:rgba(242,166,90,.1)}.chip.gd{color:var(--gold);border-color:rgba(242,193,78,.45)}
.rv{opacity:0}.slide.on .rv{animation:rise .8s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i,0)*.1s + .2s)}
@keyframes rise{from{opacity:0;transform:translateY(28px);filter:blur(8px)}to{opacity:1;transform:none;filter:none}}
.cover .in{position:relative}.sprout{position:absolute;right:0;bottom:-20px;width:min(34vw,330px);height:auto;overflow:visible;filter:drop-shadow(0 0 14px var(--glow))}
.sprout path{fill:none;stroke:var(--g);stroke-width:3;stroke-linecap:round;stroke-dasharray:400;stroke-dashoffset:400}
.sprout .lf{fill:rgba(61,220,132,.16);stroke:var(--lime)}.sprout circle{fill:var(--gold);opacity:0}
.slide.on .sprout path{animation:draw 2.4s .5s ease-out forwards}.slide.on .sprout .lf{animation-delay:1.6s;animation-duration:1.6s}
.slide.on .sprout circle{animation:pop .6s 2.6s both,pulse 2.4s 3.2s infinite}
@keyframes draw{to{stroke-dashoffset:0}}@keyframes pop{from{opacity:0;transform:scale(0)}to{opacity:1;transform:scale(1)}}@keyframes pulse{50%{opacity:.4}}
.split{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:center}
.arrow{font:700 2em var(--d);color:var(--g);animation:nudge 1.6s ease-in-out infinite}@keyframes nudge{50%{transform:translateX(8px)}}
.scatter{position:relative;height:220px}.scatter span{position:absolute;border:1px dashed var(--line);background:rgba(4,16,10,.7);border-radius:8px;padding:6px 11px;font:500 .8em var(--m);animation:drift 5s ease-in-out infinite;animation-delay:calc(var(--k)*-.8s)}
@keyframes drift{50%{transform:translate(var(--x,12px),var(--y,-10px)) rotate(var(--r,2deg))}}
.core{margin:10px auto;width:128px;height:128px;border-radius:50%;display:grid;place-items:center;font:800 1.05em var(--d);color:#04100a;background:radial-gradient(circle at 30% 30%,var(--lime),var(--g));box-shadow:0 0 60px 10px var(--glow);animation:beat 3s ease-in-out infinite}
@keyframes beat{50%{transform:scale(1.12)}}.mid{text-align:center}
.stats{display:flex;gap:14px;flex-wrap:wrap;margin-top:16px}.stat{flex:1;min-width:110px;text-align:center}
.stat b{display:block;font:800 clamp(34px,5vw,58px) var(--d);color:var(--lime);line-height:1;text-shadow:0 0 20px rgba(182,242,60,.4)}.stat small{color:var(--mut)}
.shared{margin-top:14px;text-align:center;border:1px dashed var(--g);border-radius:12px;padding:10px;color:var(--g);font:600 .86em var(--m);letter-spacing:.04em;position:relative;overflow:hidden}
.shared::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,var(--glow),transparent 70%);transform:translateX(-100%);animation:sw 3.4s linear infinite}@keyframes sw{to{transform:translateX(100%)}}
.map{display:grid;grid-template-columns:repeat(10,1fr);gap:3px;position:relative;margin-top:10px}
.map i{aspect-ratio:1.3;border-radius:3px;opacity:0;transform:scale(.4)}.slide.on .map i{animation:cell .5s calc(var(--k)*.012s + .5s) both,flick 4s calc(var(--k)*.19s + 1.6s) ease-in-out infinite}@keyframes flick{50%{opacity:.5;filter:brightness(1.5)}}
@keyframes cell{to{opacity:.9;transform:none}}
.map::after{content:"";position:absolute;top:-6px;bottom:-6px;width:3px;left:0;background:var(--lime);box-shadow:0 0 16px 4px var(--lime);border-radius:3px;animation:mv 4.6s ease-in-out infinite alternate}@keyframes mv{to{left:calc(100% - 3px)}}
.dec{display:grid;grid-template-columns:repeat(36,1fr);gap:2px;margin:10px 0 6px}.dec i{height:26px;border-radius:2px;background:var(--line)}
.dec i.w{background:linear-gradient(var(--lime),var(--g));box-shadow:0 0 10px var(--glow);animation:pulse 2.4s calc(var(--k)*.08s) infinite}
.cap{font:500 .7em var(--m);color:var(--mut);letter-spacing:.04em}
.list{list-style:none;margin:8px 0 0;padding:0}.list li{padding:5px 0 5px 24px;position:relative;font-size:.92em;color:var(--mut)}.list li::before{position:absolute;left:0;font-weight:700}
.yes li::before{content:"✓";color:var(--g)}.no li::before{content:"✕";color:var(--warn)}
.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:12px;position:relative;margin-top:8px}
.flow::before{content:"";position:absolute;left:4%;right:4%;top:22px;height:2px;background:linear-gradient(90deg,var(--line) 0 35%,var(--g) 50%,var(--line) 65% 100%);background-size:250% 100%;animation:shim 3s linear infinite}@keyframes shim{to{background-position:-250% 0}}
.flow::after{content:"";position:absolute;left:4%;top:22px;height:2px;width:0;background:linear-gradient(90deg,var(--lime),var(--g));box-shadow:0 0 12px var(--glow)}
.slide.on .flow::after{animation:ln 2.6s .5s ease-out forwards}@keyframes ln{to{width:92%}}
.step{text-align:center;position:relative}.n{width:46px;height:46px;margin:0 auto 8px;border-radius:50%;display:grid;place-items:center;font:700 1em var(--d);background:var(--bg);border:2px solid var(--g2);color:var(--g);position:relative;z-index:1}
.step.h .n{background:var(--g);color:#04100a;animation:ping 2s infinite}@keyframes ping{0%{box-shadow:0 0 0 0 var(--glow)}70%,100%{box-shadow:0 0 0 14px transparent}}
.step h3{margin:0 0 4px;font:600 .88em var(--d)}.step p{margin:0 0 6px;font-size:.78em;color:var(--mut);line-height:1.4}
.price{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.price div{text-align:center;border:1px solid var(--line);border-radius:10px;padding:8px 4px}
.price b{display:block;font:700 1.08em var(--d);color:var(--gold)}.price small{color:var(--mut);font-size:.75em}
.bar{font-size:.86em;margin-bottom:10px}.bar .t{display:flex;justify-content:space-between;margin-bottom:4px}.bar .t span{color:var(--mut);font:500 .85em var(--m)}
.tr{height:8px;border-radius:99px;background:var(--line);overflow:hidden}.tr i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--g),var(--lime))}
.slide.on .tr i{animation:fill 1.4s calc(var(--k)*.12s + .4s) ease-out forwards}@keyframes fill{to{width:var(--w)}}
.cta{background:linear-gradient(135deg,var(--g2),var(--g));border:0;color:#04100a}.cta h3,.cta p{color:#04100a}.cta p{font-weight:500}.cta::before,.cta::after{border-color:#04100a}
.nav{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));display:flex;gap:12px;align-items:center;justify-content:center}
.nav button{font:600 15px var(--d);width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--g);cursor:pointer}.nav button:hover{background:var(--g);color:#04100a}
.nav button:focus-visible,.dot:focus-visible{outline:2px solid var(--lime);outline-offset:3px}
.dots{display:flex;gap:8px}.dot{width:9px;height:9px;border-radius:99px;border:0;padding:0;background:var(--line);cursor:pointer;transition:all .3s}.dot.on{width:28px;background:var(--g);box-shadow:0 0 10px var(--glow)}
.cnt{font:600 12px var(--m);color:var(--mut);min-width:46px;text-align:center}

@keyframes spin{to{transform:rotate(360deg)}}
.sun{position:fixed;left:50%;top:62%;width:1000px;height:1000px;margin:-500px 0 0 -500px;z-index:0;pointer-events:none;opacity:.32;background:repeating-conic-gradient(rgba(242,193,78,.55) 0 4deg,transparent 4deg 12deg);-webkit-mask-image:radial-gradient(circle,#000 0,transparent 62%);mask-image:radial-gradient(circle,#000 0,transparent 62%);animation:spin 90s linear infinite}
.drone{position:fixed;top:15vh;left:0;width:84px;z-index:3;pointer-events:none;animation:fly 26s linear infinite}
@keyframes fly{0%{transform:translate(-120px,0)}25%{transform:translate(28vw,-24px)}50%{transform:translate(56vw,10px)}75%{transform:translate(84vw,-20px)}100%{transform:translate(calc(100vw + 120px),0)}}
.drone svg{width:100%;overflow:visible;animation:bob 2.2s ease-in-out infinite}@keyframes bob{50%{transform:translateY(-6px) rotate(2deg)}}
.rot{transform-box:fill-box;transform-origin:center;animation:rot .18s linear infinite}@keyframes rot{50%{transform:scaleX(.25)}}
.beam{animation:beam 1.8s ease-in-out infinite}@keyframes beam{50%{opacity:.35}}
.radar{position:fixed;right:22px;top:62px;width:92px;height:92px;border-radius:50%;z-index:3;border:1px solid var(--line);display:none;pointer-events:none;background:radial-gradient(circle,transparent 0 30%,var(--line) 30.5% 31.5%,transparent 32% 62%,var(--line) 62.5% 63.5%,transparent 64%)}
.radar::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(transparent 0 300deg,rgba(61,220,132,.55) 360deg);animation:spin 3.2s linear infinite}
.radar i{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--lime);box-shadow:0 0 8px var(--lime);opacity:0;animation:blip 3.2s infinite}@keyframes blip{10%{opacity:1}60%{opacity:0}}
@media (min-width:1200px){.radar{display:block}}
.tick{position:fixed;top:34px;left:0;right:0;height:18px;overflow:hidden;z-index:4;pointer-events:none;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.tick div{display:inline-block;white-space:nowrap;font:500 10px/18px var(--m);letter-spacing:.2em;color:var(--g);opacity:.7;animation:tk 42s linear infinite}@keyframes tk{to{transform:translateX(-50%)}}
.crops{position:fixed;left:0;right:0;bottom:0;height:78px;z-index:1;pointer-events:none;opacity:.6}
.crops i{position:absolute;bottom:0;width:2px;border-radius:2px;background:linear-gradient(to top,#1f9d55,#b6f23c);transform-origin:50% 100%;animation:sway var(--t,4s) ease-in-out infinite;animation-delay:var(--dl,0s)}
.crops i::after{content:"";position:absolute;top:-7px;left:-2px;width:6px;height:11px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px rgba(242,193,78,.7)}
@keyframes sway{0%,100%{transform:rotate(-5deg)}50%{transform:rotate(6deg)}}
.slide.on .sprout{transform-origin:50% 100%;animation:sway2 5s 3.2s ease-in-out infinite}@keyframes sway2{50%{transform:rotate(3deg)}}
.core{position:relative;margin:30px auto}.core::before,.core::after{content:"";position:absolute;border-radius:50%}
.core::before{inset:-14px;border:1.5px dashed var(--g);animation:spin 14s linear infinite}
.core::after{inset:-30px;border:1.5px solid var(--line);border-top-color:var(--lime);animation:spin 7s linear infinite reverse}
.stat b{animation:gl 3s ease-in-out infinite}@keyframes gl{50%{text-shadow:0 0 34px rgba(182,242,60,.85)}}
.card::before,.card::after{animation:cn 3s ease-in-out infinite}@keyframes cn{50%{opacity:.25;width:22px;height:22px}}
.tr i{position:relative;overflow:hidden}.tr i::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.65),transparent 70%);transform:translateX(-100%);animation:sw 2.4s linear infinite}
@media (max-width:820px){.drone{width:60px}.crops{height:56px}}
@media (max-width:820px){.g2,.split{grid-template-columns:1fr}.arrow{transform:rotate(90deg);animation:none}.slide{justify-content:flex-start}.sprout{opacity:.35}.flow::before,.flow::after{display:none}.hud span:last-child{display:none}.scatter{height:190px}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.rv{opacity:1}.sprout path{stroke-dashoffset:0}.map i{opacity:.9;transform:none}.tr i{width:var(--w)}.drone,.radar,.crops,.sun,.tick{display:none}}
</style>
</head>
<body>
<div class="sky"></div><canvas id="fx" aria-hidden="true"></canvas><div class="field" aria-hidden="true"></div><div class="scan" aria-hidden="true"></div>
<div class="sun" aria-hidden="true"></div>
<div class="drone" aria-hidden="true"><svg viewBox="0 0 100 130"><defs><linearGradient id="bm" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b6f23c" stop-opacity=".55"/><stop offset="1" stop-color="#3ddc84" stop-opacity="0"/></linearGradient></defs><polygon class="beam" points="40,34 60,34 98,128 2,128" fill="url(#bm)"/><g stroke="#3ddc84" stroke-width="2" stroke-linecap="round"><line x1="36" y1="26" x2="14" y2="16"/><line x1="64" y1="26" x2="86" y2="16"/></g><rect x="36" y="20" width="28" height="14" rx="6" fill="#0a2614" stroke="#3ddc84" stroke-width="2"/><circle cx="50" cy="27" r="3" fill="#b6f23c"/><ellipse class="rot" cx="14" cy="14" rx="13" ry="2.5" fill="#b6f23c"/><ellipse class="rot" cx="86" cy="14" rx="13" ry="2.5" fill="#b6f23c"/></svg></div>
<div class="radar" aria-hidden="true"><i style="left:60%;top:22%"></i><i style="left:30%;top:60%;animation-delay:-1.2s"></i><i style="left:70%;top:68%;animation-delay:-2.2s"></i></div>
<div class="crops" id="crops" aria-hidden="true"></div>
<div class="tick" aria-hidden="true"><div>AGROFIT · MAPA ✦ ZARC · EMBRAPA ✦ PTAX · BANCO CENTRAL ✦ PISO DE FRETE · ANTT ✦ ALERTAS · MAPBIOMAS ✦ CAR ✦ LCDPR ✦ PAGAMENTO POR PIX ✦ AGROFIT · MAPA ✦ ZARC · EMBRAPA ✦ PTAX · BANCO CENTRAL ✦ PISO DE FRETE · ANTT ✦ ALERTAS · MAPBIOMAS ✦ CAR ✦ LCDPR ✦ PAGAMENTO POR PIX ✦ </div></div>
<div class="top"><i id="pg"></i></div>
<div class="hud" aria-hidden="true"><span><b>●</b> NORSEED · AGRO HUB</span><span id="hs">SLIDE 01</span></div>
<main class="deck">

<section class="slide cover on" data-t="Capa">
  <div class="in">
    <svg class="sprout" viewBox="0 0 200 260" aria-hidden="true"><path d="M100 250 C100 190 98 140 100 70"/><path class="lf" d="M100 150 C60 150 36 126 34 96 C70 96 94 116 100 150Z"/><path class="lf" d="M100 110 C140 108 164 84 168 52 C130 54 106 76 100 110Z"/><circle cx="100" cy="64" r="7"/></svg>
    <div class="tag rv" style="--i:0">Hub do agro · em desenvolvimento</div>
    <h1 class="rv" style="--i:1">Norseed</h1>
    <p class="lead rv" style="--i:2;margin-top:18px;font-size:1.25em;max-width:34ch">As ferramentas e a gestão do produtor rural, com dado oficial e uma conta só.</p>
    <div class="chips rv" style="--i:3"><span class="chip">Dado de fonte oficial</span><span class="chip">PIX, sem assinatura nas ferramentas</span><span class="chip gd">Escritório só entra com o aceite do titular</span></div>
  </div>
</section>

<section class="slide" data-t="Problema">
  <div class="in">
    <div class="tag rv" style="--i:0">01 · O problema</div>
    <h2 class="rv" style="--i:1">Do campo ao escritório, <em>tudo solto</em></h2>
    <p class="lead rv" style="--i:2">O agrônomo abre uma aba para cada fonte. No fim do mês, o escritório contábil recebe notas por foto e planilha, e digita tudo de novo.</p>
    <div class="split rv" style="--i:3">
      <div class="card"><h3>Hoje</h3><div class="scatter">
        <span style="--k:0;left:2%;top:4%">agrofit.gov</span><span style="--k:1;left:48%;top:2%;--x:-14px">zoneamento embrapa</span>
        <span style="--k:2;left:4%;top:34%;--y:12px">câmbio bcb</span><span style="--k:3;left:56%;top:34%">tabela antt</span>
        <span style="--k:4;left:0;top:66%;--r:-3deg">fotos no zap</span><span style="--k:5;left:50%;top:66%;--x:10px">planilha à mão</span></div></div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="card mid"><h3>Com a Norseed</h3><div class="core">1 conta</div><p>Consultas juntas e gestão com o escritório, com regras claras sobre quem vê o quê.</p></div>
    </div>
  </div>
</section>

<section class="slide" data-t="Hub">
